{
  "name": "dsh-restart-button",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Restart caption button for the DSH window: the click asks for confirmation, then closes DSH completely and starts it again, so freshly installed or updated plugins take effect.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./helper.cjs": "./helper.cjs",
    "./icon.svg": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "helper.cjs",
    "icon.svg",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json"
  ]
}
